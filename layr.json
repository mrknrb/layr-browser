{
  "repository": "https://github.com/mrknrb/layr-browser",
  "id": "browser",
  "name": "Browser",
  "version": "0.2.0",
  "description": "Web pages in tabs: a start page for your bookmarks, private tabs, history, downloads and site settings.",
  "author": "layr",
  "layr": "^0.1",
  "icon": "public",
  "permissions": ["data"],
  "panels": [
    { "id": "start", "title": "Start", "page": "panels/start.html", "icon": "travel_explore" },
    { "id": "page", "title": "Web page", "external": true, "icon": "public" },
    { "id": "history", "title": "History", "page": "panels/history.html", "icon": "history", "single": true }
  ],
  "commands": [
    { "id": "open", "title": "Browser: Open web page…", "panel": "start", "params": { "transient": true } },
    { "id": "bookmarks", "title": "Browser: Bookmarks", "panel": "start", "params": { "edit": true } }
  ],
  "menus": [
    { "menu": "File", "command": "open", "group": "2" },
    { "menu": "View", "command": "bookmarks" }
  ],
  "keybindings": [{ "key": "ctrl+l", "command": "open" }],
  "settings": [
    { "id": "searchEngine", "type": "enum", "title": "Search engine", "default": "duckduckgo",
      "description": "What the address bar and the start page search with.",
      "options": [
        { "value": "duckduckgo", "title": "DuckDuckGo" },
        { "value": "google", "title": "Google" },
        { "value": "bing", "title": "Bing" },
        { "value": "brave", "title": "Brave Search" },
        { "value": "startpage", "title": "Startpage" },
        { "value": "ecosia", "title": "Ecosia" }
      ] },
    { "id": "keepHistory", "type": "boolean", "title": "Keep a history", "default": true,
      "description": "The pages you open (never a private tab's), for History and the address bar's suggestions." },
    { "id": "savePasswords", "type": "boolean", "title": "Offer to save passwords", "default": false },
    { "id": "fillForms", "type": "boolean", "title": "Fill in forms (addresses, names)", "default": true }
  ]
}
